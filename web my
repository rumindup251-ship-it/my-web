<!DOCTYPE html>
<html>
<head>
    <title>My Mini Website</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
        }

        /* NAVBAR */
        .navbar {
            background: #1877F2;
            padding: 15px;
            text-align: center;
        }

        .navbar a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }

        /* SECTIONS */
        section {
            padding: 50px;
            text-align: center;
        }

        #home {
            background: linear-gradient(to right, #4facfe, #00f2fe);
            color: white;
        }

        #about {
            background: #f1f1f1;
        }

        #contact {
            background: #ddd;
        }

        /* LOGIN BOX */
        .login-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            width: 300px;
            margin: auto;
            box-shadow: 0px 0px 10px rgba(0,0,0,0.2);
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
        }

        button {
            width: 100%;
            padding: 10px;
            background: #1877F2;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background: #0f5bd3;
        }

        .msg {
            margin-top: 10px;
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
    <a href="#home">Home</a>
    <a href="#login">Login</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
</div>

<!-- HOME -->
<section id="home">
    <h1>Welcome to Chenuwa 100k</h1>
    <p>This is a simple web site</p>
</section>

<!-- LOGIN -->
<section id="login">
    <h2>Login</h2>

    <div class="login-box">
        <input type="text" id="user" placeholder="Username">
        <input type="password" id="pass" placeholder="Password">

        <button onclick="login()">Login</button>

        <div class="msg" id="msg"></div>
    </div>
</section>

<!-- ABOUT -->
<section id="about">
    <h2>About</h2>
    <p> HI සාදරෙයෙන් පිලිගන්නවා මගේ එකට
       මම චෙනුත් මව contact  කරගන්න පහල nomber එකට massage  දාන්න.</p>
</section>

<!-- CONTACT -->
<section id="contact">
    <h2>Contact</h2>
    <p>WhatsApp: 0751443799</p>
</section>

<script>
function login() {
    var u = document.getElementById("user").value;
    var p = document.getElementById("pass").value;
    var msg = document.getElementById("msg");

    if (u === "chenuth" && p === "1234") {
        msg.innerHTML = "Login Success!";
        msg.style.color = "green";
    } else {
        msg.innerHTML = "Wrong Username or Password!";
        msg.style.color = "red";
    }
}
</script>

</body>
</html>
